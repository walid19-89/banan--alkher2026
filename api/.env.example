# Copy to api/.env and fill in real values. Never commit api/.env.
# Connection string: Neon dashboard → Project → Connect.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Signing key for session JWTs (64 hex characters recommended).
AUTH_SECRET=change-me
# Shared secret for scheduled endpoints under /cron/*.
CRON_SECRET=change-me
# Comma-separated allowed browser and app origins.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://banan-fund.netlify.app,https://localhost,capacitor://localhost
PG_POOL_MAX=2
DB_SSL=require
