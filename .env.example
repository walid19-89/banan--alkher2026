# ---------------------------------------------------------------------------
# Production web app (Vite)
# ---------------------------------------------------------------------------
# Absolute API origin baked into the bundle. On Netlify the API is served from
# the same origin under /api, so leave this empty for the web build.
VITE_API_BASE_URL=
# Public URL used inside QR verification links (no trailing slash).
VITE_PUBLIC_APP_URL=https://banan-fund.netlify.app
# Optional: legacy edge region hint. Safe to leave empty.
VITE_EDGE_REGION=

# ---------------------------------------------------------------------------
# API and database (Neon PostgreSQL)
# Local:      postgres://postgres@localhost:55432/banan
# Production: Neon pooler connection string; append ?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres@localhost:55432/banan
AUTH_SECRET=
PG_POOL_MAX=10
PORT=8787
APP_ORIGINS=http://localhost:5173,http://localhost:8787
CRON_SECRET=

# ---------------------------------------------------------------------------
# Web Push (VAPID)
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---------------------------------------------------------------------------
# Legacy Supabase recovery tooling only.
# The running app no longer reads any of these values. They are kept so the old
# project can still be exported/verified until every installed APK is 1.0.27+.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_STORAGE_BUCKET=fund-files
SUPABASE_BACKUP_BUCKET=fund-backups
